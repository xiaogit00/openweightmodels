# Production inputs for ticket 29. Copy to prod.env (gitignored), fill in, then:
#   source prod.env
#   pnpm deploy:prod
#
# This file holds no secrets. The OpenRouter key goes straight into Secrets
# Manager with a hidden prompt; the Sentry DSN is the only optional write key.

export AWS_REGION=ap-southeast-1

export OWM_ENVIRONMENT=production
export OWM_STACK_PREFIX=OwmProd
export OWM_NAME_PREFIX=owm-prod

export OWM_PROD_ACCOUNT=000000000000

export OWM_DOMAIN_NAME=openweightmodels.net
export OWM_HOSTED_ZONE_ID=Z00000000000000000000
export OWM_HOSTED_ZONE_NAME=openweightmodels.net
export OWM_SES_IDENTITY=openweightmodels.net
export OWM_EMAIL_FROM='OpenWeightModels <no-reply@openweightmodels.net>'

# Invite-only launch: keep search indexing off until the public launch.
export OWM_SIGNIN_ALLOWED_EMAILS='you@example.com'
export OWM_ALLOW_SEARCH_INDEXING=false

export OWM_ALARM_EMAIL=you@example.com
export OWM_MONTHLY_BUDGET_USD=400
export OWM_MONTHLY_SPEND_CAP_USD=100

# false while SES is in the sandbox; flip to true after production access.
export OWM_SES_PRODUCTION_ACCESS=false

# Optional; without it errors go to structured CloudWatch logs only.
# export OWM_SENTRY_DSN=https://key@o123.ingest.sentry.io/456789

export OWM_GITHUB_REPO=owner/openweightmodels
export OWM_GITHUB_BRANCH=main
export OWM_GITHUB_ENVIRONMENT=production

# Optional sizing/count overrides. Unset uses the production profile:
#   web 1 vCPU / 2 GiB, 2..6 tasks; worker 1 vCPU / 2 GiB, 1..4 tasks;
#   db.t4g.small Multi-AZ, 100..500 GB; 2-node cache.t4g.small; 2 NAT gateways.
# export OWM_WEB_DESIRED_COUNT=2
# export OWM_MIN_WEB_TASKS=2
# export OWM_MAX_WEB_TASKS=6
# export OWM_WORKER_DESIRED_COUNT=1
# export OWM_MIN_WORKER_TASKS=1
# export OWM_MAX_WORKER_TASKS=4
# export OWM_WEB_CPU=1024
# export OWM_WEB_MEMORY=2048
# export OWM_WORKER_CPU=1024
# export OWM_WORKER_MEMORY=2048
# export OWM_DB_INSTANCE_CLASS=BURSTABLE4_GRAVITON
# export OWM_DB_INSTANCE_SIZE=SMALL
# export OWM_DB_ALLOCATED_STORAGE=100
# export OWM_DB_MAX_ALLOCATED_STORAGE=500
# export OWM_DB_BACKUP_RETENTION_DAYS=14
# export OWM_CACHE_NODE_TYPE=cache.t4g.small
# export OWM_NAT_GATEWAYS=2
