{
  "name": "openweightmodels",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @owm/web --filter @owm/worker dev",
    "dev:web": "pnpm --filter @owm/web dev",
    "dev:worker": "pnpm --filter @owm/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "test": "pnpm -r --if-present test",
    "test:e2e": "tsx e2e/prepare.ts && playwright test",
    "db:generate": "pnpm --filter @owm/core db:generate",
    "db:migrate": "pnpm --filter @owm/core db:migrate",
    "db:init": "pnpm --filter @owm/core db:init",
    "db:seed": "pnpm --filter @owm/core db:seed",
    "db:reset": "pnpm --filter @owm/core db:reset",
    "stack:up": "docker compose up --build",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down --volumes --remove-orphans && docker compose up --build",
    "stack:logs": "docker compose logs -f web worker",
    "stack:seed": "docker compose run --rm migrate node_modules/.bin/tsx packages/core/src/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
