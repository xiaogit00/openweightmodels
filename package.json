{
  "name": "openweightmodels",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @owm/web --filter @owm/worker dev",
    "dev:web": "pnpm --filter @owm/web dev",
    "dev:worker": "pnpm --filter @owm/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @owm/core db:generate",
    "db:migrate": "pnpm --filter @owm/core db:migrate",
    "db:seed": "pnpm --filter @owm/core db:seed",
    "db:reset": "pnpm --filter @owm/core db:reset"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
