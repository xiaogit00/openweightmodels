{
  "name": "@owm/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/db/schema.ts",
    "./upload": "./src/domain/upload.ts",
    "./markdown": "./src/domain/markdown.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "bullmq": "^6.4.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "uuidv7": "^1.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
