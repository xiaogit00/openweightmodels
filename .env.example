# Local defaults match docker-compose.yml. With Homebrew, use your OS user:
# postgres://$(whoami)@localhost:5432/openweightmodels
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openweightmodels
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Postgres connections per web or worker process.
# DATABASE_POOL_MAX=10

# Auth. Magic links are emailed through Mailpit locally and SES in production.
# BETTER_AUTH_SECRET signs session cookies; use a long random value in production.
EMAIL_FROM=OpenWeightModels <hello@openweightmodels.test>
SMTP_URL=smtp://localhost:1025
BETTER_AUTH_SECRET=openweightmodels-development-secret-change-me
# Optional: magic-link requests per IP per 60 seconds (default 5).
# MAGIC_LINK_RATE_LIMIT_MAX=5

# Dev identity switcher (POST /api/dev/user). Impossible to use when
# NODE_ENV=production. There is no implicit default identity: local writers
# switch to a seeded handle or sign in with a magic link.
ALLOW_DEV_USER_SWITCH=true

# Generation. Mock is the default for development and tests. A real mode is
# selected with PROVIDER=openrouter and needs OPENROUTER_API_KEY: the worker
# refuses to start without it rather than silently falling back to mock.
PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MOCK_DELAY_MS=28
MOCK_FAIL_ONCE=false
# Optional: with MOCK_FAIL_ONCE, fail only this model slug (default: every model).
# MOCK_FAIL_MODEL=deepseek-v3

# Guardrails
MAX_CHALLENGERS=4
JOBS_PER_HOUR=10
RUNS_PER_DAY=50
PROVIDER_CONCURRENCY=4

# A failed Run is auto-skipped after this delay (24 hours).
AUTO_SKIP_DELAY_MS=86400000

# Browser suite. It seeds this database and flushes this Redis DB itself, and
# refuses to run against DATABASE_URL or REDIS_URL.
E2E_DATABASE_URL=postgres://localhost:5432/openweightmodels_e2e
E2E_REDIS_URL=redis://localhost:6379/1

# --- Local stack (docker compose) -----------------------------------------
# Host ports only. Container-to-container traffic always uses postgres:5432,
# redis:6379 and mailpit:1025. Change these when Homebrew already owns a port.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
WEB_PORT=3000

# Optional worker liveness endpoint. Leave unset for local `pnpm dev:worker`;
# docker compose sets it to 3001 and maps the same host port.
# WORKER_HEALTH_PORT=3001
