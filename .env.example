# Local defaults match docker-compose.yml. With Homebrew, use your OS user:
# postgres://$(whoami)@localhost:5432/openweightmodels
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openweightmodels
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Postgres connections per web or worker process.
# DATABASE_POOL_MAX=10

# Auth (M2). SES replaces Mailpit in production. Compose points SMTP_URL at the
# Mailpit container; nothing sends mail until magic links land (ticket 07).
EMAIL_FROM=OpenWeightModels <hello@openweightmodels.test>
SMTP_URL=smtp://localhost:1025

# Dev identity. Ignored when NODE_ENV=production.
DEV_DEFAULT_USER=mira
ALLOW_DEV_USER_SWITCH=true

# Generation. Mock is the default; set a provider key to run real calls.
PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MOCK_DELAY_MS=28
MOCK_FAIL_ONCE=false
# Optional: with MOCK_FAIL_ONCE, fail only this model slug (default: every model).
# MOCK_FAIL_MODEL=deepseek-v3

# Guardrails
MAX_CHALLENGERS=4
JOBS_PER_HOUR=10
RUNS_PER_DAY=50
PROVIDER_CONCURRENCY=4

# A failed Run is auto-skipped after this delay (24 hours).
AUTO_SKIP_DELAY_MS=86400000

# Browser suite. It seeds this database and flushes this Redis DB itself, and
# refuses to run against DATABASE_URL or REDIS_URL.
E2E_DATABASE_URL=postgres://localhost:5432/openweightmodels_e2e
E2E_REDIS_URL=redis://localhost:6379/1

# --- Local stack (docker compose) -----------------------------------------
# Host ports only. Container-to-container traffic always uses postgres:5432,
# redis:6379 and mailpit:1025. Change these when Homebrew already owns a port.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
WEB_PORT=3000

# Optional worker liveness endpoint. Leave unset for local `pnpm dev:worker`;
# docker compose sets it to 3001 and maps the same host port.
# WORKER_HEALTH_PORT=3001
