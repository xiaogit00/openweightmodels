# Local defaults match docker-compose.yml. With Homebrew, use your OS user:
# postgres://$(whoami)@localhost:5432/openweightmodels
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openweightmodels
REDIS_URL=redis://localhost:6379
# Runtime public URL (server-side; not inlined into the client bundle).
# A legacy NEXT_PUBLIC_APP_URL is still accepted.
APP_URL=http://localhost:3000

# Optional: Postgres connections per web or worker process.
# DATABASE_POOL_MAX=10

# Production (ECS) injects discrete database variables from Secrets Manager
# instead of a URL. Each part is URL-encoded before assembly; DB_SSL requests
# TLS with sslmode=require.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=openweightmodels
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true

# ElastiCache in staging is reached by host/port with in-transit TLS.
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=true

# Auth. Magic links are emailed through Mailpit locally and SES in production.
# BETTER_AUTH_SECRET signs session cookies; use a long random value in production.
# EMAIL_TRANSPORT=smtp (default) or ses. `ses` uses the ECS task role and the
# SES v2 API, so no SMTP credentials are stored.
EMAIL_FROM=OpenWeightModels <hello@openweightmodels.test>
SMTP_URL=smtp://localhost:1025
BETTER_AUTH_SECRET=openweightmodels-development-secret-change-me
# Optional: comma-separated sign-in allowlist. `you@example.com` allows one
# address, `@example.com` allows a domain. Unset allows any address (the local
# default). With an allowlist set, blocked requests get the same neutral
# response as a sent link and no email is delivered.
# SIGNIN_ALLOWED_EMAILS=you@example.com
# Optional: magic-link requests per IP per 60 seconds (default 5).
# MAGIC_LINK_RATE_LIMIT_MAX=5

# Dev identity switcher (POST /api/dev/user). Impossible to use when
# NODE_ENV=production. There is no implicit default identity: local writers
# switch to a seeded handle or sign in with a magic link.
ALLOW_DEV_USER_SWITCH=true

# Generation. Mock is the default for development and tests. A real mode is
# selected with PROVIDER=openrouter and needs OPENROUTER_API_KEY: the worker
# refuses to start without it rather than silently falling back to mock.
PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Opt-in real-provider smoke call: pnpm test:live (needs a key below).
# Optional: LIVE_PROVIDER_MODEL=deepseek/deepseek-chat
MOCK_DELAY_MS=28
MOCK_FAIL_ONCE=false
# Optional: with MOCK_FAIL_ONCE, fail only this model slug (default: every model).
# MOCK_FAIL_MODEL=deepseek-v3

# Guardrails
MAX_CHALLENGERS=4
JOBS_PER_HOUR=10
RUNS_PER_DAY=50
PROVIDER_CONCURRENCY=4

# A failed Run is auto-skipped after this delay (24 hours).
AUTO_SKIP_DELAY_MS=86400000

# Browser suite. It seeds this database and flushes this Redis DB itself, and
# refuses to run against DATABASE_URL or REDIS_URL.
E2E_DATABASE_URL=postgres://localhost:5432/openweightmodels_e2e
E2E_REDIS_URL=redis://localhost:6379/1

# --- Local stack (docker compose) -----------------------------------------
# Host ports only. Container-to-container traffic always uses postgres:5432,
# redis:6379 and mailpit:1025. Change these when Homebrew already owns a port.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
WEB_PORT=3000

# Optional worker liveness endpoint. Leave unset for local `pnpm dev:worker`;
# docker compose sets it to 3001 and maps the same host port.
# WORKER_HEALTH_PORT=3001

# --- AWS staging (ticket 13) ----------------------------------------------
# Read by `pnpm deploy:staging` (infra/scripts/deploy.sh). These are not
# secrets: the provider key lives in Secrets Manager and is set once after the
# first deploy. See docs/DEPLOYMENT.md.
# AWS_REGION=eu-west-1
# OWM_DOMAIN_NAME=staging.example.com
# OWM_HOSTED_ZONE_ID=Z0123456789          # or OWM_CERTIFICATE_ARN=arn:aws:acm:...
# OWM_HOSTED_ZONE_NAME=example.com        # parent zone when the app is a subdomain
# OWM_SES_IDENTITY=staging.example.com
# OWM_EMAIL_FROM=OpenWeightModels <no-reply@staging.example.com>
# OWM_PROVIDER=openrouter
# OWM_STACK_PREFIX=OwmStaging
# OWM_NAME_PREFIX=owm-staging
# OWM_SIGNIN_ALLOWED_EMAILS=you@example.com,@example.org
# OWM_ALLOW_SEARCH_INDEXING=false   # true only for a public launch; needs a rebuild
# IMAGE_TAG=
